<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Shazamzin.Core\Shazamzin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.31" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- schema.sql embutido no assembly: SqliteInitializer cria o banco sem depender de arquivo solto -->
    <EmbeddedResource Include="Sqlite\schema.sql" LogicalName="schema.sql" />
  </ItemGroup>

</Project>
