{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Valkey": { "ConnectionString": "localhost:6379" },
  "Sqlite": { "ConnectionString": "Data Source=./data/shazamzin.db" },
  "Auth": { "ApiKey": "dev-key-local" },
  "Matching": {
    "Provider": "Valkey",
    "DeltaBucketMs": 50,
    "MinScoreThreshold": 8
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
