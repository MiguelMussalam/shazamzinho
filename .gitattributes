# Normaliza line endings: LF no repositório, conversão automática no checkout.
* text=auto

# Scripts/fontes que preferem LF mesmo no Windows
*.sh    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cs    text eol=lf
*.md    text eol=lf

# Scripts PowerShell: CRLF
*.ps1   text eol=crlf

# Binários
*.db    binary
*.dll   binary
*.so    binary
